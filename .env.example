# -------------- 1. APPLICATION --------------
APP_ENV=development
LOG_LEVEL=INFO


# -------------- 2. FRONT END --------------
BACKEND_URL=http://localhost:8000


# Local Development:
# FastAPI:
# http://localhost:8000


# Streamlit:
# http://localhost:8501


# -------------- 3. DATABASE - PostgreSQL --------------
# Database url format: postgresql+asyncpg://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql+asyncpg://<your username>:<your password>@localhost:5432/<your database name>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PORT_FORWARD=5432
POSTGRES_USER=<your username>
POSTGRES_PASSWORD=<your password>
POSTGRES_DB=<your database name>


# -------------- 4. AUTHENTICATION --------------
# secret needs to be at least 32 random characters
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # one hour

# -------------- 5. EMBEDDING MODEL --------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=http://localhost:11434/v1


# -------------- 6. LLM MODEL --------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.8:latest
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1


# -------------- 7. RETRIEVAL CONFIGURATION --------------
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.2
RETRIEVAL_MAX_CONTEXT_CHARS=12000
AGENT_MAX_RETRIEVAL_RETRIES=1
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=25


# -------------- 8. MODEL CONTEXT PROTOCOL --------------
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
MCP_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_SERVER_URL=http://localhost:8001/mcp


# -------------- 9. GOOGLE DRIVE INTEGRATION --------------
GOOGLE_DRIVE_MCP_URL=https://drivemcp.googleapis.com/mcp/v1
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_QUOTA_PROJECT=
GOOGLE_DRIVE_INCLUDE_SUBFOLDERS=true
GOOGLE_DRIVE_MAX_FILES=100



# Tev1 decision endpoint for document chunk classification
DECISION_MODEL_PROVIDER=ollama
DECISION_MODEL=tev1:0.8b
DECISION_API_KEY=
DECISION_BASE_URL=http://localhost:11434/v1/systemone
DECISION_TIMEOUT_SECONDS=120
DECISION_KEEP_ALIVE=10m
